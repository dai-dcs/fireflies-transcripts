# ---- Fireflies ----
FIREFLIES_API_KEY=your_fireflies_api_key
FIREFLIES_WEBHOOK_SECRET=your_webhook_signing_secret

# ---- OCI Object Storage ----
# Use an OCI config file (~/.oci/config) with a matching key, OR instance principal.
OCI_CONFIG_PROFILE=DEFAULT
OCI_NAMESPACE=your_object_storage_namespace
OCI_BUCKET=fireflies-transcripts
OCI_REGION=us-ashburn-1

# ---- Service ----
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8787
STATE_DB_PATH=./state.db
LOG_LEVEL=INFO
