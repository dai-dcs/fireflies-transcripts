[Unit]
Description=Fireflies -> OCI Object Storage webhook connector
After=network.target

[Service]
Type=simple
User=opc
WorkingDirectory=/opt/fireflies-oci-connector
EnvironmentFile=/opt/fireflies-oci-connector/.env
ExecStart=/opt/fireflies-oci-connector/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8787
Restart=on-failure
RestartSec=5
StandardOutput=append:/opt/fireflies-oci-connector/logs/service.log
StandardError=append:/opt/fireflies-oci-connector/logs/service.log

[Install]
WantedBy=multi-user.target
